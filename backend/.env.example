# Local defaults. Browser connection settings override these per request.
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
ONLINE_SOURCES=false

# Optional command-line BYOK configuration. Prefer the app settings for session-only keys.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_FALLBACK_MODELS=

# Optional NCBI rate-limit key when online sources are enabled.
# NCBI_API_KEY=

CHROMA_PATH=../data/chroma
PHARMER_MODEL_CACHE=./.cache
